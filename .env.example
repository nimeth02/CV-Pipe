# SMTP settings used to send application emails.
# Copy this file to .env.local and fill in real values there (never here).
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Optional: sender address and name (defaults to SMTP_USER)
MAIL_FROM=
MAIL_FROM_NAME=Your Name
